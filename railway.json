{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksConfigPath": "BirQadamDjango/nixpacks.toml"
    },
    "deploy": {
        "startCommand": "chmod +x BirQadamDjango/start.sh && bash BirQadamDjango/start.sh",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}