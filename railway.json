{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacksConfigPath": "BirQadamDjango/nixpacks.toml",
        "dockerfilePath": null,
        "ignorePaths": ["**/Dockerfile", "**/*.dockerfile", "BirQadamDjango/Dockerfile", "BirQadamDjango/frontend/Dockerfile"]
    },
    "deploy": {
        "startCommand": "cd BirQadamDjango && chmod +x start.sh && bash start.sh",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}