{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "cd BirQadamDjango && pip install -r requirements.txt"
    },
    "deploy": {
        "startCommand": "cd BirQadamDjango && chmod +x start.sh && bash start.sh",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}